{
  "name": "lumen",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Lúmen — devocional reformado gamificado (PWA)",
  "scripts": {
    "dev": "vite",
    "build": "npm run check && tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "content:bible": "node scripts/import-bible.mjs",
    "content:catechism": "node scripts/import-catechism.mjs",
    "content": "npm run content:bible && npm run content:catechism",
    "check": "node scripts/check-content.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-pwa": "^0.21.1"
  }
}
