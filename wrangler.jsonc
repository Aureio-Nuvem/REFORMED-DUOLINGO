{
  // Deploy do Lúmen como site estático (Static Assets) no Cloudflare.
  // Sem "main": é um deploy só de assets (a pasta dist), sem código de Worker.
  // Isso evita a auto-configuração de framework do wrangler (que exige Vite 6).
  "name": "reformed-duolingo",
  "compatibility_date": "2024-11-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
