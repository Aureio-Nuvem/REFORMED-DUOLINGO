{
  // Lúmen no Cloudflare Workers: o Worker serve a API em /api/* e entrega o
  // app (dist) pelo binding ASSETS. O SPA cai em index.html nas outras rotas.
  "name": "reformed-duolingo",
  "main": "worker/index.ts",
  "compatibility_date": "2024-11-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  // Banco do login e da sincronização. As tabelas e o segredo de sessão são
  // criados pelo próprio Worker na primeira chamada da API (ver NUVEM.md).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lumen-db",
      "database_id": "04b81f12-8d5f-4f20-a43b-874c091293ec"
    }
  ]
}
